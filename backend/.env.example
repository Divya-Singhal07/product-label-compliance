SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
GROQ_API_KEY=your_groq_api_key
# Prefer a non-reasoning model with reliable json_object output.
# openai/gpt-oss-20b is a reasoning model and often returns empty content.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: GROQ_MAX_TOKENS=2500
# Optional (reasoning models only): GROQ_MAX_COMPLETION_TOKENS=8000
